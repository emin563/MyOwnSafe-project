{
  "expo": {
    "name": "Vault - Document Archive",
    "slug": "promptblueprint-opensource-demo",
    "version": "1.5.1",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000001"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "promptblueprint",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Vault uses the camera to scan and capture documents, receipts, and warranties.",
        "NSPhotoLibraryUsageDescription": "Vault accesses your photo library so you can import existing documents.",
        "NSPhotoLibraryAddUsageDescription": "Vault may save document images to your photo library."
      }
    },
    "android": {
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.example.vault"
            },
            {
              "scheme": "com.googleusercontent.apps.YOUR_ANDROID_OAUTH_CLIENT_ID"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "allowBackup": false,
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "package": "com.example.vault"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Vault uses the camera to scan and capture documents.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vault accesses your photos and files so you can import documents and save exports.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#10a37f",
          "defaultChannel": "vault-expiry"
        }
      ],
      "expo-secure-store",
      "./plugins/withAndroidGoogleDriveOAuthIntent",
      "./plugins/withAndroidRemoveBroadMediaPermissions"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000001"
      },
      "googleDriveOAuth": {
        "androidClientId": "YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com",
        "webClientId": ""
      }
    }
  }
}
