# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.expo-ascii-sdk/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore

# Android release signing (passwords — never commit)
android/keystore.properties
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Secrets — never commit (tracked exception: .env.example only)
.env*
!.env.example

# EAS credentials export (passwords + keystore paths) — never commit
credentials.json
credentials/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
